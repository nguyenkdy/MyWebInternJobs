<%-
  include("../layout", {
    title,
    currentUser,
    body: `
      <section class="page">
        <h1>Find internships</h1>
        <form class="filters" method="get" action="/jobs">
          <input class="input" name="q" placeholder="Search title, company, location" value="${q ? String(q).replaceAll('"', "&quot;") : ""}" />
          <div class="filter-dropdown">
            <input type="hidden" name="type" value="${type ? String(type) : ""}" />
            <button type="button" class="button button--ghost filter-type-button" aria-haspopup="listbox" aria-expanded="false">
              ${type === "internship" ? "Internship" : type === "part-time" ? "Part-time" : type === "full-time" ? "Full-time" : "Any type"}
            </button>
            <div class="filter-type-list" role="listbox" aria-label="Job type options" hidden>
              <button type="button" class="filter-type-item ${!type ? "active" : ""}" data-value="">Any type</button>
              <button type="button" class="filter-type-item ${type === "internship" ? "active" : ""}" data-value="internship">Internship</button>
              <button type="button" class="filter-type-item ${type === "part-time" ? "active" : ""}" data-value="part-time">Part-time</button>
              <button type="button" class="filter-type-item ${type === "full-time" ? "active" : ""}" data-value="full-time">Full-time</button>
            </div>
          </div>
          <button class="button" type="submit">Search</button>
        </form>

        <div class="jobs">
          ${
            jobs.length
              ? jobs
                  .map(
                    (j) => `
                      <div class="job job--static">
                        <div class="job__top">
                          <div class="job__title">${j.title}</div>
                          <span class="badge">${j.type}</span>
                        </div>
                        <div class="job__meta">
                          <span>
                            <a href="/companies/${j.companyUserId}" style="color: inherit; text-decoration: none;">${j.companyName}</a>
                          </span>
                          <span class="dot">•</span>
                          <span>${j.location || "Remote / Flexible"}</span>
                        </div>
                        <div class="row row--gap" style="margin-top: 10px;">
                          <a class="button button--ghost" href="/jobs/${j._id}">View Details</a>
                        </div>
                      </div>
                    `
                  )
                  .join("")
              : `<div class="muted">No jobs found.</div>`
          }
        </div>
      </section>
    `,
  })
%>

